# Token bot dari @BotFather (wajib)
TELEGRAM_BOT_TOKEN=

# Batasi user Telegram yang boleh pakai bot (csv, kosong = semua boleh)
# Contoh: ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# Batas iterasi agent per prompt (default 25)
AGENT_MAX_ITERATIONS=25

# Timeout approval aksi di mode ASK, dalam ms (default 15 menit)
APPROVAL_TIMEOUT_MS=900000
